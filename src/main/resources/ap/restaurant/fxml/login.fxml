<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ap.restaurant.controllers.LoginController">

    <children>
          <VBox prefHeight="400.0" prefWidth="600.0" style="-fx-alignment: center;">
              <children>
            <Region prefHeight="49.0" prefWidth="600.0" />
                  <Label prefHeight="66.0" prefWidth="109.0" text="Login">
                      <font>
                          <Font size="44.0" />
                      </font>
                  </Label>
                  <Region prefHeight="76.0" prefWidth="600.0" />
                  <TextField fx:id="usernameField" maxHeight="-Infinity" maxWidth="-Infinity" prefHeight="5.0" prefWidth="364.0" promptText="Username" />
            <Region prefHeight="54.0" prefWidth="600.0" />
                  <PasswordField fx:id="passwordField" maxHeight="-Infinity" maxWidth="-Infinity" prefHeight="26.0" prefWidth="364.0" promptText="Password" />
                  <Region prefHeight="54.0" prefWidth="600.0" />
                  <Button onAction="#onLoginClick" text="Login" />
                  <HBox prefHeight="59.0" prefWidth="598.0" style="-fx-alignment: center;">
                      <children>
                          <Label text="Don't have an account?" />
                          <Hyperlink onAction="#onSignUpClick" text="SignUp" />
                      </children>
                  </HBox>
            <Region prefHeight="54.0" prefWidth="600.0" />
              </children>
          </VBox>
    </children>
</AnchorPane>
