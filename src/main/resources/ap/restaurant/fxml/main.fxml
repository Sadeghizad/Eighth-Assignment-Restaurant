<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.TilePane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<TilePane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ap.restaurant.controllers.MainController">

    <children>
        <SplitPane dividerPositions="0.34" prefHeight="400.0" prefWidth="600.0">
            <items>

                <!-- Left: Cart -->
                <AnchorPane prefWidth="200.0">
                    <children>
                        <VBox alignment="CENTER" prefHeight="400.0" prefWidth="200.0" style="-fx-alignment: center;">
                            <children>
                                <Label text="Cart">
                                    <font><Font size="24.0" /></font>
                                </Label>

                                <ListView fx:id="cartList" prefHeight="301.0" prefWidth="200.0" />

                                <HBox alignment="CENTER" prefHeight="28.0" prefWidth="200.0" spacing="10">
                                    <padding>
                                        <Insets bottom="10" left="10" right="10" top="10" />
                                    </padding>

                                    <children>
                                        <Button fx:id="removeButton" onAction="#onRemoveClick" text="Remove">
                                            <font>
                                    <Font size="16.0" />
                                 </font>
                                        </Button>
                                        <Button fx:id="checkoutButton" onAction="#onCheckoutClick" text="Checkout">
                                            <font><Font size="16.0" /></font>
                                        </Button>
                                    </children>
                                </HBox>
                            </children>
                        </VBox>
                    </children>
                </AnchorPane>

                <!-- Right: Menu -->
                <AnchorPane prefWidth="400.0">
                    <children>
                        <VBox prefHeight="400.0" prefWidth="400.0" spacing="10">
                            <padding>
                                <Insets bottom="10" left="10" right="10" top="10" />
                            </padding>
                            <children>
                                <Label text="Menu">
                                    <font><Font size="24.0" /></font>
                                </Label>

                                <ListView fx:id="menuList" prefHeight="300.0" prefWidth="360.0" />

                                <!-- Add to cart controls -->
                                <HBox spacing="10">
                                    <TextField fx:id="quantityField" promptText="Quantity">
                                        <font><Font size="14.0" /></font>
                                    </TextField>
                                    <Button onAction="#onAddClick" text="Add">
                                        <font><Font size="14.0" /></font>
                                    </Button>
   
                                   <!-- Total Label aligned to left -->
                                   <HBox alignment="BOTTOM_RIGHT">
                                       <Label fx:id="totalLabel" text="Total: 0 Toman">
                                           <font>
                                    <Font size="16.0" />
                                 </font>
                                       </Label>
                                   </HBox>
                                </HBox>
                            </children>
                        </VBox>
                    </children>
                </AnchorPane>

            </items>
        </SplitPane>
    </children>
</TilePane>
