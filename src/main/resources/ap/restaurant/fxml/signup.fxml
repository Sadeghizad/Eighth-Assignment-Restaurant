<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ap.restaurant.controllers.SignUpController">

    <children>
          <VBox prefHeight="498.0" prefWidth="598.0" style="-fx-alignment: center;">
              <children>
                  <Label prefHeight="66.0" prefWidth="138.0" text="Signup">
                      <font>
                          <Font size="44.0" />
                      </font>
                  </Label>

                  <Region prefHeight="40.0" />
                  <TextField fx:id="usernameField" maxWidth="-Infinity" prefWidth="364.0" promptText="Username" />

                  <Region prefHeight="20.0" />
            <TextField fx:id="emailField" layoutX="128.0" layoutY="196.0" maxWidth="-Infinity" prefWidth="364.0" promptText="Email" />
            <Region layoutX="10.0" layoutY="221.0" prefHeight="20.0" />
                  <PasswordField fx:id="passwordField" maxWidth="-Infinity" prefHeight="26.0" prefWidth="364.0" promptText="Password" />

                  <Region prefHeight="20.0" />
                  <PasswordField fx:id="confirmPasswordField" maxWidth="-Infinity" prefHeight="26.0" prefWidth="364.0" promptText="Repeat Password" />

                  <Region prefHeight="30.0" />
                  <Button onAction="#onSignUpClick" text="Sign Up" />

                  <HBox prefHeight="59.0" prefWidth="598.0" style="-fx-alignment: center;">
                      <children>
                          <Label text="Have an account?" />
                          <Hyperlink onAction="#onLoginLinkClick" text="Login" />
                      </children>
                  </HBox>
              </children>
          </VBox>
    </children>
</AnchorPane>
